generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                      String    @id @default(cuid())
  createdAt               DateTime  @default(now())
  name                    String                          // "FTMO #1", "My Funded Trader"
  broker                  String                          // "FTMO", "MFF", "Pepperstone"
  type                    String                          // "Prop" | "Live" | "Personal" | "Demo"
  market                  String    @default("forex")     // "forex" | "futures" | "stocks" | "crypto"
  status                  String                          // "Phase1" | "Phase2" | "Funded" | "Live" | "Passed" | "Failed" | "Breached" | "Archived"
  currency                String    @default("USD")
  startingBalance         Float
  currentBalance          Float
  profitTarget            Float?
  maxDrawdownPct          Float                           // e.g. 10.0 for 10%
  dailyDrawdownLimitPct   Float                           // e.g. 5.0 for 5%
  currentDrawdownPct      Float     @default(0)
  currentDailyDrawdownPct Float     @default(0)
  payoutStatus            String    @default("None")      // "None" | "Requested" | "Paid"
  notes                   String?
  isActive                Boolean   @default(true)
  // MT4 auto-logging integration
  mt4AccountNumber        Int?      @unique               // broker-assigned MT4 login number (e.g. 1234567)
  mt4Server               String?                         // MT4 server name (e.g. "FTMO-Server2")
  apiKey                  String?   @unique               // bearer token the EA sends on every request
  lastSyncedAt            DateTime?                       // last time the EA POSTed anything for this account
  currentEquity           Float?                          // live equity from MT4 (balance + floating P&L); MT4 EA writes this on every trade event
  // Controls what the EA does when it's attached to a chart on this account.
  // The EA reads this from /api/trades/mt4/state on OnInit and respects it:
  //   • "full"          — history catchup + realtime opens/modifies/closes (default)
  //   • "realtime-only" — skip catchup; realtime events still flow. Use once
  //                       you're authoritative on history via broker CSV.
  //   • "off"           — EA detaches itself: no catchup, no polling.
  eaSyncMode              String    @default("full")
  trades                  Trade[]
}

model Trade {
  id                 String           @id @default(cuid())
  createdAt          DateTime         @default(now())
  date               DateTime
  pair               String           // e.g. "NZD/USD"
  direction          String           // "Long" | "Short"
  model              String           // "A" | "B"
  grade              String           // "A+" | "B" | "C"
  session            String           // "London" | "New York" | "Tokyo"
  entryPrice         Float
  slPrice            Float            // current SL — updated by EA modify events (BE moves, trailing). Do NOT use for R math.
  initialSlPrice     Float?           // SL at the moment of fill — never modified. Source of truth for R calc.
  tpPrice            Float
  closePrice         Float?
  riskPercent        Float            @default(1.0)
  riskAmount         Float?           // amount risked in account currency, entered at take time. Source of truth when set; riskPercent derived from it.
  resultR            Float?           // profit/loss in R
  resultPips         Float?
  outcome            String?          // "Win" | "Loss" | "BE" | "Open"
  reason             String           // entry reason — one sentence
  notes              String?          // general notes
  preTradeNotes      String?          // written before entry
  postTradeNotes     String?          // written after close
  screenshotUrl      String?          // setup screenshot (Supabase storage)
  closeScreenshotUrl String?          // review screenshot after close
  strongCcy          String           // top currency at time of trade
  weakCcy            String           // bottom currency at time of trade
  divScore           Float?           // divergence score at entry
  tags               String[]         // e.g. ["wyckoff-spring", "ny-session"]
  assetClass         String           @default("forex")   // "forex" | "futures" | "stocks" | "crypto"
  instrument         String?          // for non-forex: "ES", "AAPL" — mirrors pair for forex
  accountId          String?          // foreign key to Account (nullable for existing trades)
  account            Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  alignments         TradeAlignment[]
  // MT4 auto-logging + idea provenance
  ticket             Int?             // MT4 broker ticket number — unique within an account
  source             String           @default("manual")  // "manual" | "mt4" | "mt4-catchup" | "claude-idea" | "user-discretionary"
  ideaId             String?          // FK back to IdeaOutcome — set when trade was opened from an idea card
  // Wyckoff read provenance. Mirrors the ideaId pattern: set automatically when
  // an EA fill matches a read you had already locked (see lib/wyckoff/link.ts).
  candidateId        String?          // FK to ScannerCandidate — the read this trade came from
  readAdherence      String?          // aligned | contradicted | traded-a-pass
  entryDriftR        Float?           // how far the fill sat from the entry you committed to, in R
  stopWidenedR       Float?           // how much wider the actual stop was than the planned one, in R
  lotSize            Float?           // MT4 contract size (e.g. 0.10)
  commission         Float?           // broker commission in account currency
  swap               Float?           // overnight swap charges
  profitCcy          Float?           // raw P&L in account currency from MT4
  openTimeUtc        DateTime?        // broker-stamped open time (UTC)
  closeTimeUtc       DateTime?        // broker-stamped close time (UTC)
  ruleViolations     String[]         // computed flags: ["after-7pm-wat", "within-30min-ny-open", "no-model", "sub-1to2-rr", "c-grade-full-risk"]
  behaviorFlags      String[]         // computed flags: ["overtrading", "revenge", "sizing-drift"]
  modifications      TradeModification[]
  @@unique([accountId, ticket])
  @@index([source, date])
  @@index([candidateId])
}

// Per-trade audit log of SL/TP modifications. The EA diffs each open ticket's
// current SL/TP against the last-seen values on every timer poll and POSTs a
// row here when they change. Lets us reconstruct the full risk timeline
// (BE moves, trail steps) — and is what backfills initialSlPrice on the parent
// Trade when the row was created before the schema had it.
model TradeModification {
  id         String   @id @default(cuid())
  tradeId    String
  trade      Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  field      String   // "sl" | "tp"
  oldValue   Float
  newValue   Float
  changedAt  DateTime @default(now())  // server time of receipt; broker time isn't always available
  createdAt  DateTime @default(now())
  @@index([tradeId, changedAt])
}

model DailyAlert {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  date          DateTime  @unique
  top3          Json      // [{cur, score, tag}]
  bottom3       Json      // [{cur, score, tag}]
  pairs9        Json      // 9-pair matrix results
  priority1     Json      // top setup (kept for backwards compat — mirrors ideas[0])
  ideas         Json?     // TradeIdea[] — all ranked setups (Phase 2)
  fullAnalysis  Json?     // full 10-section structured output from Claude (Phase 2)
  dataAge       Int?      // age of Barchart snapshot in minutes when analysis ran
  scoringModel  String?   // which Claude model produced this result e.g. "claude-sonnet-4-6"
  rawCalendar   String?
  rawPerf       String?
  rawStddev     String?
  sentAt        DateTime?
  telegramMsgId Int?
}

// Cron run health log — one row per cron execution
model SyncHealth {
  id                   String   @id @default(cuid())
  checkedAt            DateTime @default(now())
  barchartAgeMinutes   Int?
  economicAgeMinutes   Int?
  ratesAgeMinutes      Int?
  status               String   // "Fresh" | "Stale" | "Missing"
  action               String   // "Scored" | "Skipped" | "Warning"
  errors               String[]

  @@index([checkedAt])
}

model CurrencyScore {
  id          String   @id @default(cuid())
  date        DateTime
  currency    String
  score       Float
  fundamental Float
  pricePerf   Float
  stdDev      Float
  notes       String[]

  @@unique([date, currency])
}

// Hourly snapshot of currency scores — used for alignment checking
model HourlyScore {
  id        String   @id @default(cuid())
  bucket    DateTime // rounded to nearest hour: new Date(Math.floor(Date.now() / 3600000) * 3600000)
  currency  String
  score     Float
  pricePerf Float    @default(0)
  top3      String[] // array of 3 currency codes currently strongest
  bottom3   String[] // array of 3 currency codes currently weakest

  @@unique([bucket, currency])
  @@index([bucket])
}

// Full ForexFactory weekly calendar — written by Railway sync service each hour
model EconomicSnapshot {
  id        String   @id @default(cuid())
  fetchedAt DateTime @default(now())
  events    Json     // EconomicEvent[] — full week, all supported currencies

  @@map("economic_snapshots")
  @@index([fetchedAt])
}

// Central bank interest rates — written by Railway sync service each hour
model RatesSnapshot {
  id        String   @id @default(cuid())
  fetchedAt DateTime @default(now())
  rates     Json     // CentralBankRate[] — current rate per currency

  @@map("rates_snapshots")
  @@index([fetchedAt])
}

// Hourly Barchart snapshot written by the Railway sync service
model BarchartSnapshot {
  id        String   @id @default(cuid())
  fetchedAt DateTime @default(now())
  data      Json     // full BarchartSnapshot shape: { forex, futures, fetchedAt, errors }
  errors    String[]

  @@map("barchart_snapshots")
  @@index([fetchedAt])
}

// Alignment check result for an open trade at a point in time
model TradeAlignment {
  id               String   @id @default(cuid())
  tradeId          String
  checkedAt        DateTime @default(now())
  status           String   // "Green" | "Amber" | "Red"
  strongStillTop3  Boolean
  weakStillBottom3 Boolean
  reason           String
  trade            Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId, checkedAt])
}

// ScoringRequest — queue of "please score now" requests from the dashboard.
// The Claude Desktop routine polls this on each fire; if pending, scores; if not, exits cheaply.
// Routes that consume the queue mark it completed so the same request isn't picked up twice.
model ScoringRequest {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  reason      String?                                // why this was requested (e.g. "manual", "api-failed")
  requestedBy String                                 // userId or "system"
  status      String    @default("pending")          // "pending" | "running" | "completed" | "expired"
  completedAt DateTime?

  @@index([status, createdAt])
}

// News-collision warning — tracks Telegram alerts sent for open-trade × upcoming-event
// combinations so we don't spam the same event twice. One row per (tradeId, eventKey).
model NewsWarning {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  tradeId   String
  eventKey  String   // hash of "title|country|date" — uniquely identifies a calendar event
  eventAt   DateTime
  currency  String   // which side of the trade the event hits ("strong" or "weak")
  impact    String   // "High" | "Medium"

  @@unique([tradeId, eventKey])
  @@index([eventAt])
}

// Single-user auth — credentials provider via NextAuth
model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  email        String   @unique
  passwordHash String                                       // bcrypt hash, never the plaintext
  name         String?
  lastLoginAt  DateTime?
}

// IdeaOutcome — every surfaced idea (from Claude OR from the user's own log) gets a row.
// Daily cron evaluates each one's outcome from next-day price action. Drives the
// algorithm scoreboard: directional accuracy, grade hit rates, invalidation accuracy.
model IdeaOutcome {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  alertDate     DateTime                                    // the DailyAlert.date this idea belonged to
  pair          String                                      // "GBP/USD"
  direction     String                                      // "Long" | "Short"
  grade         String                                      // "A+" | "B" | "C" | "Skip"
  strong        String                                      // ranked-strongest currency at time of idea
  weak          String                                      // ranked-weakest currency at time of idea
  divergence    Float                                       // divergence score (or user-perceived strength)

  // ── Source: where the idea came from ──────────────────────────────────────
  source        String    @default("claude")                // "claude" | "user-discretionary"
  priorityRank  Int?                                        // Claude ideas: rank within the day (1=top); user ideas: null
  // Fields populated when source = "user-discretionary"
  userModel     String?                                     // "A" (Wyckoff) | "B" (liquidity run)
  userReason    String?                                     // one-sentence rationale
  userSession   String?                                     // "London" | "New York" | "Tokyo" | "Pre-NY"

  // ── User action: clear three-way outcome on every idea ───────────────────
  userAction          String   @default("none")             // "taken" | "watched" | "invalidated" | "none"
  actedAt             DateTime?                             // when the user took/watched/invalidated
  invalidationReason  String?                               // free text + preset reasons
  takenByUser         Boolean  @default(false)              // shorthand for userAction == "taken" (kept for backwards compat)
  tradeId             String?                               // link to the Trade if taken

  // ── Outcome: computed by daily cron from next-day price ──────────────────
  evaluatedAt     DateTime?
  outcome         String?                                   // "Win" | "Loss" | "Neutral" | "Pending"
  priceMoveR      Float?                                    // R-multiple the idea would have produced (using ATR-derived SL)
  pipMove         Float?                                    // signed pip move from idea direction (positive = idea correct)
  actualDirection String?                                   // "up" | "down" | "flat" — raw next-day direction regardless of idea
  closePrice      Float?                                    // next-day close price for transparency
  notes           String?

  // ── Watch tracking ────────────────────────────────────────────────────────
  // Captured when the user clicks Watch (with the optional entry+SL dialog) so
  // the dashboard can show live R-multiple progress on calls they didn't take.
  // Lets us measure algorithm strength without risking real capital.
  watchEntryPrice Float?                                    // the price they'd have entered at
  watchSlPrice    Float?                                    // their last-swing-low SL anchor
  watchStartedAt  DateTime?                                 // when watch was first armed
  watchLastPrice  Float?                                    // most recent quoted price (cron-updated)
  watchPeakR      Float?                                    // best R reached since watchStartedAt
  watchTroughR    Float?                                    // worst R reached since watchStartedAt
  watchLastSeenAt DateTime?                                 // last time the price was refreshed

  @@unique([alertDate, pair, direction, source])
  @@index([alertDate])
  @@index([outcome])
  @@index([source, userAction])
}

// ── Trend-Strength Screener ───────────────────────────────────────────────────
// Daily H4 sweep of the whole universe (forex, metals, indices, big stocks).
// Goal: rank markets by trend freshness/strength so the week's focus list is a
// numbers game, not a forced trade. Volume/effort refinement is done manually
// on MT4 for the shortlist. Runs alongside RFDM scoring for comparison.

model ScanRun {
  id         String       @id @default(cuid())
  createdAt  DateTime     @default(now())
  runType    String       @default("daily")   // "daily" | "weekly-digest" | "manual"
  universe   Int                              // how many symbols were attempted
  scanned    Int                              // how many succeeded
  errors     String?                          // JSON array of { symbol, message }
  results    ScanResult[]

  @@index([createdAt])
}

model ScanResult {
  id        String   @id @default(cuid())
  runId     String
  run       ScanRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  symbol      String                          // Yahoo symbol, e.g. "EURUSD=X", "GC=F", "^GSPC", "NVDA"
  displayName String                          // human name, e.g. "EUR/USD", "Gold", "S&P 500"
  assetClass  String                          // "forex" | "metal" | "index" | "stock" | "crypto" | "energy"
  tradeable   Boolean  @default(true)         // tradeable on the user's MT4 account

  // ── Indicator snapshot (H4, resampled from 1h) ────────────────────────────
  lastClose   Float
  adx         Float                           // ADX(14) on H4
  adxPrev     Float                           // ADX 5 bars ago (slope check)
  plusDi      Float
  minusDi     Float
  ema20       Float
  ema50       Float
  atrPct      Float                           // ATR(14) as % of price — volatility context
  er          Float    @default(0)            // Kaufman Efficiency Ratio(20) — 1 = straight-line trend, ~0 = range

  // ── Derived classification ────────────────────────────────────────────────
  direction   String                          // "long" | "short" | "none" (DI dominance + EMA agreement)
  phase       String                          // "fresh" | "established" | "fading" | "none"
  condition   String   @default("transition") // "trend" | "big-range" | "tight-range" | "transition"

  // ── Range box (set when condition is a range) ─────────────────────────────
  rangeHigh     Float?
  rangeLow      Float?
  rangeWidthAtr Float?                        // box width in ATR(14) multiples — 4+ = "big" range
  pricePosition Float?                        // 0 = at range low, 1 = at range high (edges = reversal watch)

  adxRising   Boolean
  emaAligned  Boolean                         // price/EMA20/EMA50 stacked in trend direction
  structureOk Boolean                         // HH/HL (or LH/LL) over recent swings
  score       Float                           // composite 0–100
  grade       String                          // "A" | "B" | "C" | "skip"

  // ── RFDM cross-check (forex only) ─────────────────────────────────────────
  rfdmAgrees  Boolean?                        // null = not a forex pair / no score available
  rfdmNote    String?                         // e.g. "RFDM: EUR #2 strong, USD #8 — agrees with long"

  // ── Automatic outcome tracking (filled in by later scans, no manual input) ─
  // R = forward move in ATR(14) units, SIGNED RELATIVE TO THE SCANNED DIRECTION
  // (positive = price went the way the scan called). For trend signals you want
  // positive R; for climax signals a negative R means the reversal thesis won.
  evalBars    Int      @default(0)            // forward H4 bars evaluated so far (caps at 30)
  rFwd5       Float?                          // R at +5 H4 bars  (~1 trading day)
  rFwd15      Float?                          // R at +15 H4 bars (~3 days)
  rFwd30      Float?                          // R at +30 H4 bars (~6 days)
  mfe30       Float?                          // best R reached within 30 bars (max favourable excursion)
  mae30       Float?                          // worst R reached within 30 bars (max adverse excursion)
  evaluatedAt DateTime?                       // set once the full 30-bar window is graded

  @@index([runId])
  @@index([symbol, createdAt])
  @@index([grade])
  @@index([evaluatedAt])
}

// ── Wyckoff Range Scanner ─────────────────────────────────────────────────────
// One row per detected trading range (keyed on instrument + range start date).
// engineVerdict is the mechanical accumulation/distribution call, LOGGED BLIND
// for the you-vs-engine benchmark — it is NEVER surfaced in the scan_ranges
// tool payload. The trader reads the chart and decides; outcome is backfilled
// by cron once RESOLVE_BARS trading days have passed after the breakout.

model ScannerCandidate {
  id             String    @id @default(cuid())
  scanDate       DateTime  @default(now())     // first time this range was seen
  instrument     String                        // spec ticker: "6E", "ES", "AAPL"
  rangeLo        Float
  rangeHi        Float
  contextPct     Float?                        // §4 trend into the range; null = <60 bars history
  terminalTest   String                        // spring | upthrust | both | none
  stoppingAction Boolean                       // §6 selling climax + automatic rally
  engineVerdict  String                        // accum | distrib | neutral (LOGGED, blind, not shown)
  loggedBlind    Boolean   @default(true)      // false = range had already resolved when first logged
                                               //         (2y history seed rows) — exclude from strict benchmark
  outcome        String?                       // up | down | chop (backfilled §9)
  outcomeAt      DateTime?                     // when the backfill resolved it
  status         String    @default("broken")  // "open" (no breakout yet) | "broken" (frozen)
  fresh          Boolean   @default(false)     // at a decision point NOW — refreshed each scan
                                               // while open; drives the readable list on /wyckoff
  // ── Trader's blind read (the "you" side of the you-vs-engine benchmark) ────
  // Logged from the /wyckoff page BEFORE resolution, then IMMUTABLE — the API
  // rejects any write once traderVerdict is set or outcome exists. Engine
  // verdict stays server-side until outcome != null.
  traderVerdict  String?                       // accum | distrib | pass
  traderEntry    Float?                        // optional committed entry price
  traderStop     Float?                        // optional committed stop price
  traderReadAt   DateTime?                     // when the read was locked

  // -- Triage & watchlist (mutable, and deliberately NOT part of the read) ----
  // A tag is not a verdict: it says "keep this in front of me", never accum or
  // distrib. Editable and reversible at any time. The benchmark reads
  // traderVerdict only, so nothing in this block can move the score.
  watch          String?                       // "now" | "later" | null (untriaged)
  watchNote      String?                       // why you flagged it - your own context
  watchAt        DateTime?                     // when it was last (re)tagged
  alertPrice     Float?                        // level set by clicking the chart
  alertSetAt     DateTime?                     // arm time - only bars AFTER this day can fire
  alertHitAt     DateTime?                     // stamped by the scan when a bar touched it
  alertHitDate   DateTime?                     // the bar date that did the touching

  // -- Structural quality grade (NEVER a direction call - see lib/wyckoff/grade.ts)
  // Built only from facts the trader payload already discloses plus the
  // boundary-touch counts detection was computing and throwing away.
  grade           String?                      // A | B | C | D
  gradeScore      Float?                       // 0..100 weighted score
  gradeFactors    Json?                        // { test, boundaries, context, maturity }
  gradeNotes      String[]                     // short reasons rendered as chips
  touchesHi       Int?
  touchesLo       Int?

  // Compact bar window for the card thumbnail, written at scan time because the
  // scanner already holds the series. Fetching per card at render time would
  // mean one Yahoo call per candidate on every page load.
  // Format: [o,h,l,c,v,"YYYY-MM-DD"][] — tuples, not objects, to keep the JSON
  // small enough to ship with every row.
  sparkBars       Json?

  // -- Timing: was the scanner early or late?
  // surfacedBarDate is the DATA date when the range first reached a decision
  // point, not the wall clock - a scan that runs late must not make the
  // scanner look late. Written once, never updated.
  surfacedAt      DateTime?
  surfacedBarDate DateTime?
  surfacedReason  String?                      // test-printed | pressing-boundary | just-broke-out
  testBarDate     DateTime?                    // bar the spring/upthrust printed on
  leadToBreakout  Int?                         // bars surfaced -> breakout (backfilled)
  leadToTest      Int?                         // bars surfaced -> terminal test (backfilled)

  // -- Stable first-occurrence facts. Written ONCE at creation and never
  // touched again, so a re-anchor corrects the range's boundaries without
  // rewriting when the setup first appeared.
  firstSeenBarDate   DateTime?   // data date the scanner first logged this range
  originalRangeStart DateTime?   // rangeStartDate as first detected, kept for audit
  reanchorCount      Int      @default(0)
  lastReanchorAt     DateTime?

  barsInRange    Int
  rangeStartDate DateTime                      // date of bar `start` — stable dedupe key
  breakoutDate   DateTime?                     // date of bar `end`; null while status = "open"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // NO unique on (instrument, rangeStartDate): rangeStartDate is a corrigible
  // ESTIMATE, not an identity. The greedy detector re-anchors it as the data
  // window rolls, and making it unique forced every re-anchor to fork a new
  // row. Identity now comes from overlap — see lib/wyckoff/identity.ts.
  @@index([instrument, rangeStartDate])
  @@index([instrument, scanDate])
  @@index([outcome, status])
  @@index([watch])
  @@index([grade, fresh])
  @@map("scanner_candidates")
}


// ── Practice ─────────────────────────────────────────────────────────────────
// Deliberate practice, kept in its OWN tables. A simulated fill must never
// reach the Trade table that computes live P&L — mixing them is how a journal
// stops being trustworthy. Same field shapes as the live side, so the same
// breakdowns can run over both and be read against each other.
model PracticeRun {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  importedAt   DateTime       @default(now())
  source       String                              // "trainer" | "replay" | "manual"
  trainerRunId String?                             // the trainer's own run id, when it has one
  label        String
  notes        String?
  cases        PracticeCase[]

  @@unique([source, trainerRunId])
  @@index([source, importedAt])
  @@map("practice_runs")
}

model PracticeCase {
  id               String       @id @default(cuid())
  runId            String
  run              PracticeRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  // The trainer's stable identity (sym|ctx|lo|hi) — re-importing the same
  // export updates rather than duplicating.
  caseKey          String
  seq              Int?
  instrument       String
  direction        String?
  entry            Float?
  stop             Float?
  orderKind        String?
  riskPct          Float?
  rrBoundary       Float?
  rrProjection     Float?
  fillBar          Int?
  fillType         String?
  result           String?                          // win | loss | be
  resultR          Float?
  maeR             Float?
  mfeR             Float?
  // Context the trainer captured at entry — this is what makes practice
  // comparable to live reads rather than just a P&L list.
  barsStepped      Int?
  springsAtEntry   Int?
  upthrustsAtEntry Int?
  stoppingAction   Boolean?
  volRatioAtEntry  Float?
  erRatioAtEntry   Float?
  erVerdictAtEntry String?
  engineVerdict    String?
  marketOutcome    String?                          // up | down | chop
  ctxPct           Float?
  bandPct          Float?
  aids             String?                          // which chart aids were on
  closedAt         DateTime?

  @@unique([runId, caseKey])
  @@index([instrument])
  @@index([runId])
  @@map("practice_cases")
}
